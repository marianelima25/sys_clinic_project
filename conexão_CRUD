# - - - -> VALIDAÇÕES

def ler_int(msg): # NÃO PERMITIR LETRAS
    while True:
        try:
            valor = int(input(msg))
            if valor > 0:
                return valor
            else:
                print("Digite um número correspondente!")
        except ValueError:
            print("Digite apenas números!")

def ler_texto(msg): # NÃO PERMITIR NÚMEROS
    while True:
        texto = input(msg).strip()

        if not texto:
            print("Campo Obrigatório!")
        elif any(char.isdigit() for char in texto):
            print("O nome não pode conter números!")
        else:
            return texto

def ler_telefone(msg): # GARANTIR UM FORMATO CORRETO PARA O TELEFONE INSERIDO
    while True:
        tel = input(msg)

        telefone_format = tel
        telefone_format = telefone_format.replace(" ", "")
        telefone_format = telefone_format.replace("-", "")
        telefone_format = telefone_format.replace("(", "")
        telefone_format = telefone_format.replace(")", "")

        if telefone_format.isdigit():
            return tel
        else:
            print("Digite um telefone válido!")

def ler_email(msg): # GARANTIR UM EMAIL CORRETO
    while True:
        email = input(msg)
        if "@" in email and "." in email:
            return email
        else:
            print("Digite um email válido!")

def ler_opcao(msg, opcoes): # GARANTIR RESPOSTAS CORRESPONDENTES COM 0/1 PARA A INATIVIDADE
    while True:
        valor = input(msg)
        if valor in opcoes:
            return valor
        else:
            print(f"Digite apenas: {', '.join(opcoes)}")

def ler_crm(msg): # GARANTIR O CRM, E O FORMATO CORRETO PARA ELE
    while True:
        crm = input(msg).strip()

        if not crm:
            print("Campo Obrigatório!")
        elif not crm.startswith("CRM/") or len(crm) < 10:
            print("Digite um CRM válido (CRM/UF 000000)")
        else:
            return crm

def ler_obs(msg):
    obs = input(msg).strip()
    return obs if obs else None

def ler_id(conexao, msg, tabela, campo):
        while True:
            try:
                valor = int(input(msg))
                if valor <= 0:
                    print("Digite um ID válido (número positivo)!")
                    continue
                cursor = conexao.cursor()
                sql = f"SELECT 1 FROM {tabela} WHERE {campo}=%s"
                cursor.execute(sql, (valor,))

                if cursor.fetchone():
                    return valor
                else:
                    print("ID não encontrado!")

            except ValueError:
                print("Digite apenas números!")

from datetime import datetime, time

def ler_data(msg): # GARANTIR UMA DATA VÁLIDA E NO FORMATO CORRETO
    while True:
        data = input(msg)
        try:
            data_formatada = datetime.strptime(data, '%Y/%m/%d')
            hoje = datetime.now()

            if data_formatada.date() < hoje.date():
                print("Não é possível agendar com essa data! Insira uma data correta no formato AAAA/MM/DD.")
                continue
            return data_formatada

        except ValueError:
            print("Digite uma data válida no formato AAAA/MM/DD!")

def ler_hora(msg):  # GARANTIR UM HORÁRIO NO FORMATO CORRETO
    while True:
        hora = input(msg)
        try:
            hora_formatada = datetime.strptime(hora, "%H:%M").time()
            abertura = time(8, 0)
            fechamento = time(18, 0)

            if not (abertura <= hora_formatada <= fechamento):
                print("Horário fora do funcionamento da clínica (08:00 às 18:00)!")
                continue
            return hora_formatada

        except ValueError:
            print("Digite um horário com um formato válido! (00:00)")


